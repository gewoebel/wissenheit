rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
    }
  }
}